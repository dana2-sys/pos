<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="fas fa-ticket-alt"></i> All Tickets</h1>
  <a href="/tickets/new" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Create New Ticket</a>
</div>

<div class="row">
  <% if (tickets.length > 0) { %>
    <% tickets.forEach(ticket => { %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 ticket-card">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= ticket.title %></h5>
            <p class="card-text flex-grow-1 text-muted"><%= ticket.description.substring(0, 100) %><% if (ticket.description.length > 100) { %>...<% } %></p>
            <div class="mt-auto d-flex justify-content-between align-items-center">
              <span class="badge
                <% if (ticket.status === 'open') { %> bg-success
                <% } else if (ticket.status === 'in_progress') { %> bg-warning text-dark
                <% } else { %> bg-danger <% } %>">
                <i class="fas fa-<%= ticket.status === 'open' ? 'folder-open' : (ticket.status === 'in_progress' ? 'spinner' : 'check-circle') %>"></i>
                <%= ticket.status.replace('_', ' ') %>
              </span>
              <a href="/tickets/<%= ticket.id %>" class="btn btn-outline-primary btn-sm">View Details <i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12">
      <div class="alert alert-info">No tickets have been created yet.</div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
